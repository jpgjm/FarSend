<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from cloud backup AND device-to-device transfer.
     From targetSdk 31 on, allowBackup="false" alone is ignored for device transfers
     (AOSP BackupEligibilityRules.isAppBackupAllowed, IGNORE_ALLOW_BACKUP_IN_D2D), so without
     this file a transfer would copy the secret key and two devices would share one ID. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
